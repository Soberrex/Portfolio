{
  "rules": {
    ".read": false,
    ".write": false,
    "presence": {
      ".read": true,
      "$sid": {
        ".write": "$sid.length <= 32",
        ".validate": "newData.hasChildren(['t']) && newData.child('t').val() == now",
        "t": { ".validate": true },
        "$other": { ".validate": false }
      }
    },
    "messages": {
      ".read": "auth != null && auth.token.email == 'subhampersonal123@gmail.com' && auth.token.email_verified == true",
      ".indexOn": ["t"],
      "$id": {
        ".write": "!data.exists() || (auth != null && auth.token.email == 'subhampersonal123@gmail.com' && auth.token.email_verified == true)",
        ".validate": "newData.hasChildren(['name', 'email', 'message', 't'])",
        "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 80" },
        "email": { ".validate": "newData.isString() && newData.val().length <= 120 && newData.val().matches(/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/)" },
        "message": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 2000" },
        "t": { ".validate": "newData.val() == now || data.val() == newData.val()" },
        "read": { ".validate": "newData.isBoolean()" },
        "$other": { ".validate": false }
      }
    }
  }
}
